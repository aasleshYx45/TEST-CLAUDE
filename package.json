{
  "name": "attendly",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --test tests/attendance.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "shots": "node scripts/shots.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "build:single": "node scripts/build-artifact.mjs",
    "mobile": "npm --prefix mobile run start",
    "mobile:check": "node scripts/mobile-check.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.62.1",
    "typescript": "~5.8.3",
    "vite": "^7.1.3"
  }
}
